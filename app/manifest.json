{
	"manifest_version": 3,
	"scope": "./",
	"name": "Bog Music",
	"short_name": "Bog Music",
	"description": "Music player with offline cache and Giper Baza sync",
	"version": "1.2.2.1",
	"action": {
		"default_title": "Bog Music",
		"default_icon": "bog/music/app/favicon.svg"
	},
	"permissions": ["storage", "cookies", "offscreen", "tabs"],
	"icons": [
		{
			"src": "bog/music/app/favicon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "bog/music/app/favicon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "maskable"
		}
	],
}
