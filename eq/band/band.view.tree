$bog_music_eq_band $mol_view
	db_text \
	freq_text \
	fill_top \
	fill_height \
	pointer_down?event null
	pointer_move?event null
	pointer_up?event null
	sub /
		<= Db $mol_paragraph
			title <= db_text
		<= Slider $mol_view
			event *
				pointerdown?event <=> pointer_down?event
				pointermove?event <=> pointer_move?event
				pointerup?event <=> pointer_up?event
				pointercancel?event <=> pointer_up?event
			sub /
				<= Zero $mol_view
				<= Fill $mol_view
					style *
						top <= fill_top
						height <= fill_height
		<= Freq $mol_paragraph
			title <= freq_text
